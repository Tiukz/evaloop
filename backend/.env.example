APP_NAME=Evaloop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=evaloop
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Local HTTP only; enable with HTTPS in deployment.
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"

# Development fixtures only. Set a strong local value; never commit it.
EVALOOP_SEED_PASSWORD=

# Private Legacy Insights attachments. Limit per file in KiB.
EVALOOP_LESSON_ATTACHMENT_MAX_KB=10240
